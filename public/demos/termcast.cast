[9.67514, "o", "\r\n\u001b[1m\u001b[36m\u2500\u2500 Step 2 \u2014 the change it made \u2500\u2500\u001b[0m\r\n\u001b[2m# src/hooks/useTheme.ts\u001b[0m\r\n\u001b[36mconst [theme, setTheme] = useState(() => localStorage.getItem('theme') ?? 'light')\u001b[0m\r\n\u001b[36museEffect(() => localStorage.setItem('theme', theme), [theme])\u001b[0m\r\n\u001b[2m# src/components/Header.tsx\u001b[0m\r\n\u001b[36m<button onClick={toggle}>{theme === 'dark' ? '\u2600\ufe0f' : '\ud83c\udf19'}</button>\u001b[0m\r\n\r\n\u001b[1m\u001b[36m\u2500\u2500 Step 3 \u2014 see it run \u2500\u2500\u001b[0m\r\n"]
